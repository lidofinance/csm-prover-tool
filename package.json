{
  "name": "csm-prover-tool",
  "version": "0.0.0",
  "description": "Tool for proving info from CL through EL for CSM validators",
  "repository": "https://github.com/lidofinance/csm-prover-tool.git",
  "author": "Community Staking Team <csm@lido.fi>",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "20.20.2",
    "yarn": "4.12.0"
  },
  "scripts": {
    "prove": "WORKING_MODE=cli node dist/main.js prove",
    "prove:debug": "WORKING_MODE=cli node --inspect dist/main.js prove",
    "slashing": "yarn prove slashing",
    "slashing:debug": "yarn prove:debug slashing",
    "withdrawal": "yarn prove withdrawal",
    "withdrawal:debug": "yarn prove:debug withdrawal",
    "bad_performer": "yarn prove bad_performer",
    "bad_performer:debug": "yarn prove:debug bad_performer",
    "balance": "yarn prove balance",
    "balance:debug": "yarn prove:debug balance",
    "typechain": "typechain --node16-modules --target=ethers-v5 --out-dir src/common/contracts/types src/common/contracts/abi/*.json",
    "prebuild": "yarn typechain",
    "build": "yarn prebuild && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:debug": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" node --inspect-brk node_modules/.bin/jest --runInBand",
    "test-daemon": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config test/jest-daemon-e2e.json",
    "test-cli": "WORKING_MODE=cli NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config test/jest-cli-e2e.json"
  },
  "dependencies": {
    "@chainsafe/persistent-merkle-tree": "^1.3.1",
    "@lido-nestjs/constants": "^5.3.0",
    "@lido-nestjs/execution": "^1.23.1",
    "@lido-nestjs/logger": "^1.3.2",
    "@lodestar/params": "^1.49.0",
    "@lodestar/types": "^1.49.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/terminus": "^12.1.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@typechain/ethers-v5": "^11.1.2",
    "@types/cli-progress": "^3.11.6",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ethers": "^5.8.0",
    "lowdb": "npm:@huanshiwushuang/lowdb@^6.0.2",
    "lru-cache": "^11.5.3",
    "nest-commander": "^3.21.0",
    "nest-commander-testing": "^3.6.0",
    "nest-winston": "^2.0.0",
    "ora": "^9.4.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0",
    "typechain": "^8.3.2",
    "undici": "^7.30.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s?$": [
        "@swc/jest",
        {
          "module": {
            "type": "es6"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
